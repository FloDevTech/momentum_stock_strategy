{
  "$schema": "https://opencode.ai/config.json",
  // Ask before shell commands; allow only routine local Git inspection.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },

    // Keep secrets unavailable to agents even if matching files appear later.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*credentials*", "effect": "deny" },
    { "action": "read", "resource": "*secrets*", "effect": "deny" },

    // Do not grant access outside this workspace from project configuration.
    { "action": "external_directory", "resource": "*", "effect": "deny" }
  ]
}